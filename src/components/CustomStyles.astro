Thầy mở file **`src/components/CustomStyles.astro`** trên GitHub, cuộn xuống dưới cùng và dán đoạn mã ngắn này:

```html
<script is:inline>
  const T = {
    t1: { b: '☯ Tinh Hoa', m: ['Khởi Duyên', 'Tam Phẩm', 'Góc Kể Chuyện', 'Minh Bạch Giám Định'], d: ['Khăn Chầu Áo Ngự', 'Pháp Phục Thiền Tịnh', 'Ngọc Cẩm Thạch Loại A'], c: 'Thỉnh Duyên' },
    t2: { b: '☯ Cổ Phong', m: ['Diện Kiến', 'Tác Phẩm', 'Điển Tích & Ngọc Học', 'Chỉ Dẫn Đo Ni'], d: ['Y Phục Nghi Lễ', 'Trang Phục Thường Nhật', 'Ngọc Phỉ Thúy Loại A'], c: 'Trò Chuyện' }
  };
  function applyT(k) {
    localStorage.setItem('vn_nav', k);
    const d = T[k], b = document.getElementById('vn-btn');
    if (b) b.innerText = d.b;
    document.querySelectorAll('header nav > ul > li > :is(a,button)').forEach((el, i) => { if (d.m[i]) el.childNodes[0].textContent = d.m[i] + ' '; });
    document.querySelectorAll('header nav ul ul li a').forEach((el, i) => { if (d.d[i]) el.textContent = d.d[i]; });
    const cta = document.querySelector('header a.btn-primary, header .actions a');
    if (cta) cta.textContent = d.c;
  }
  function initT() {
    let k = localStorage.getItem('vn_nav') || 't1';
    const box = document.querySelector('header .items-center.flex.gap-3, header .actions');
    if (box && !document.getElementById('vn-btn')) {
      const btn = document.createElement('button');
      btn.id = 'vn-btn';
      btn.className = 'text-xs px-2 py-1 rounded border font-medium mr-1 text-emerald-700 dark:text-emerald-300';
      btn.onclick = () => { k = k === 't1' ? 't2' : 't1'; applyT(k); };
      box.prepend(btn);
    }
    applyT(k);
  }
  document.addEventListener('DOMContentLoaded', initT);
  document.addEventListener('astro:after-swap', initT);
</script>
