<!-- NẠP FONT GOOGLE CHUẨN TIẾNG VIỆT & TIẾNG ANH (KHÔNG BAO GIỜ BỊ VỠ DẤU) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,700;1,400&family=Playfair+Display:ital,wght@0,600;0,700;0,900;1,600&display=swap" rel="stylesheet">

<style is:inline is:global>
  :root {
    --aw-font-sans: 'Be Vietnam Pro', sans-serif;
    --aw-font-serif: 'Playfair Display', serif;
    --aw-font-heading: 'Playfair Display', serif;

    /* PALETTE KHỞI DUYÊN (LIGHT MODE): Trắng Thoải Phủ chủ đạo */
    --aw-color-primary: #1B4D3E;       /* Xanh ngọc bích Nhạc Phủ */
    --aw-color-secondary: #C84B31;     /* Đỏ san hô Thiên Phủ */
    --aw-color-accent: #D4AF37;        /* Vàng kim Địa Phủ */
    --aw-color-bg-page: #FAF8F5;       /* Trắng giấy dó thanh tịnh */
    --aw-color-text-heading: #18231C;  /* Chữ đen đậm rõ nét */
    --aw-color-text-default: #2C3E35;  /* Chữ nội dung sắc nét */
    --aw-color-text-muted: #526B5E;    /* Chữ phụ */
  }

  .dark {
    /* PALETTE KHỞI DUYÊN (DARK MODE): Đen trầm & Ngọc sáng */
    --aw-color-primary: #3CB371;
    --aw-color-secondary: #E05A47;
    --aw-color-accent: #E5C158;
    --aw-color-bg-page: #0F1412;
    --aw-color-text-heading: #F5FAF7;
    --aw-color-text-default: #D8E5DF;
    --aw-color-text-muted: #8FA89D;
  }

  /* Ép buộc mọi tiêu đề dùng font Playfair chuẩn tiếng Việt */
  h1, h2, h3, .font-serif {
    font-family: 'Playfair Display', serif !important;
  }
</style>
