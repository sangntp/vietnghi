---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Việt Nghi — Chân Truyền Lề Lối & Giám Định Ngọc Học',
};
---

<Layout metadata={metadata}>
  <!-- TOÀN BỘ KHÔNG GIAN ĐỎ GẤM & VÀNG HOÀNG KIM CỦA THIÊN PHỦ -->
  <div class="bg-[#180404] text-[#F5EBE1] border-b border-[#D4AF37]/30">
    
    <!-- THANH CHUYỂN KHÔNG GIAN ĐẶC BIỆT DÀNH CHO BẠN ĐỌC -->
    <div class="bg-[#3D0303] text-center py-2.5 px-4 text-xs tracking-wider border-b border-[#D4AF37]/20 flex justify-center items-center gap-3">
      <span class="text-[#D4AF37] font-serif">KHO TƯ LIỆU KHẢO CỨU LỀ LỐI ĐẠO MẪU</span>
      <a href="/" class="bg-[#FBF9F5] text-[#1B4D3E] font-semibold px-3 py-1 rounded-full text-xs hover:bg-white transition shadow">
        🌿 Chuyển sang giao diện Khởi Duyên (Người Trẻ)
      </a>
    </div>

    <!-- 1. Hero: Nền Đỏ Rượu Trầm & Chữ Vàng Cổ -->
    <Hero
      actions={[
        {
          variant: 'primary',
          text: 'Thỉnh Trang & Thẩm Định',
          href: 'https://zalo.me',
          target: '_blank',
          class: 'bg-[#D4AF37] text-[#180404] hover:bg-[#b8952b] font-bold border-none',
        },
      ]}
    >
      <Fragment slot="title">
        <span class="font-serif text-[#D4AF37]">CHÂN TRUYỀN LỀ LỐI TIỀN NHÂN</span> <br />
        <span class="text-red-300 font-serif text-3xl sm:text-4xl">Bảo Chứng Ngọc Học Thuần Khiết</span>
      </Fragment>

      <Fragment slot="subtitle">
        <span class="text-[#E6D5C3]">Không gian dành riêng cho các bậc đồng đền, đạo quan và nhà sưu tầm trân quý quy thức khăn chầu áo ngự chuẩn Tứ Phủ cùng giá trị vĩnh cửu của ngọc Phỉ Thúy loại A.</span>
      </Fragment>
    </Hero>

    <!-- 2. Khăn Chầu Áo Ngự: Đi sâu vào Sắc Tộc Tứ Phủ -->
    <Content
      isReversed
      tagline="SẮC PHỤC TỨ PHỦ"
      title="Quy Thức Khăn Chầu Áo Ngự"
      classes={{ container: 'text-[#F5EBE1]' }}
      items={[
        {
          title: 'Đỏ Thiên Phủ — Uy Nghi Tối Thượng',
          description: 'Dành cho hàng Quan Lớn Đệ Nhất, Chầu Đệ Nhất. Sắc đỏ gấm thêu phượng cuộn mây bằng chỉ kim tuyến chuẩn mực, không pha tạp màu sắc hiện đại.',
        },
        {
          title: 'Xanh Nhạc Phủ & Vàng Địa Phủ',
          description: 'Sắc xanh ngọc bích của rừng ngàn và sắc vàng hoàng kim của lòng đất. Mỗi đường kim đều giữ đúng thần thái tôn nghiêm khi hầu bóng.',
        },
        {
          title: 'Trắng Thoải Phủ — Thanh Khiết Bất Nhiễm',
          description: 'Sắc trắng tựa nước nguồn ngọc tuyền dành cho giá Thoải Phủ, đính sa hạt và thêu hoa sen giấu chỉ tinh tế.',
        },
      ]}
    >
      <Fragment slot="content">
        <p class="text-[#D4AF37] font-serif italic text-lg mb-2">"Gửi nét chỉ hoa, họa hồn phượng gấm"</p>
        <span class="text-[#D6C4B2]">Mỗi chiếc áo ngự tại Việt Nghi là một tác phẩm phụng sự, tôn vinh nét đẹp cha truyền con nối.</span>
      </Fragment>
    </Content>

    <!-- 3. Giám Định Ngọc Học Minh Bạch -->
    <Features2
      title="Minh Bạch Ngọc Học — 100% Cẩm Thạch Loại A"
      subtitle="Minh bạch tuyệt đối chứng thư quang phổ hồng ngoại FTIR, không xử lý hóa chất."
      columns={3}
      items={[
        {
          title: 'Giám Định Viện Đá Quý',
          description: 'Mỗi vòng ngọc đều có mã số kiểm định độc lập từ PNJ Lab / RGG / SJC.',
          icon: 'tabler:certificate',
        },
        {
          title: 'Nước Ngọc & Độ Mướt',
          description: 'Chất ngọc mịn màng, thớ ngọc đan chặt, lên nước sáng bóng theo năm tháng dưỡng ngọc.',
          icon: 'tabler:sparkles',
        },
        {
          title: 'Trường Năng Lượng Đất Mẹ',
          description: 'Hấp thụ linh khí tự nhiên hàng triệu năm, hỗ trợ điều hòa từ trường và dưỡng tâm an lạc.',
          icon: 'tabler:shield-check',
        },
      ]}
    />

    <!-- 4. Lời Mời Đàm Đạo -->
    <CallToAction
      actions={[
        {
          variant: 'primary',
          text: 'Đàm Đạo Quy Thức & Xem Ngọc',
          href: 'https://zalo.me',
          target: '_blank',
          class: 'bg-[#D4AF37] text-[#180404] font-bold hover:bg-[#b8952b] border-none',
        },
      ]}
    >
      <Fragment slot="title">
        <span class="font-serif text-[#D4AF37]">Hội Ngộ Cùng Việt Nghi</span>
      </Fragment>
      <Fragment slot="subtitle">
        <span class="text-[#E6D5C3]">Kính mời quý thầy ghé đàm đạo về phục trang tín ngưỡng hoặc soi nước ngọc dưới ánh sáng chuyên dụng.</span>
      </Fragment>
    </CallToAction>
  </div>
</Layout>
