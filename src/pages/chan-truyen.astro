---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Việt Nghi — Chân Truyền Lề Lối & Giám Định Ngọc Học',
};
---

<Layout metadata={metadata}>
  <!-- NỀN ĐỎ GẤM THIÊN PHỦ CHUẨN CUNG ĐÌNH -->
  <div class="bg-[#240303] text-[#F7EFE9] min-h-screen">
    
    <!-- THANH TRƯỢT CHUYỂN KHÔNG GIAN DẠNG PILL SANG TRỌNG -->
    <div class="sticky top-16 z-30 flex justify-center py-3 bg-[#1A0202]/95 backdrop-blur-md border-b border-[#D4AF37]/30">
      <div class="inline-flex p-1 bg-[#3A0505] rounded-full border border-[#D4AF37]/40 shadow-lg">
        <a href="/" class="px-5 py-1.5 rounded-full text-xs font-medium text-stone-300 hover:text-white transition-all">
          🌿 Khởi Duyên (Người Trẻ)
        </a>
        <span class="px-5 py-1.5 rounded-full text-xs font-bold bg-[#8B0000] text-[#D4AF37] border border-[#D4AF37]/60 shadow-md">
          ☯ Chân Truyền (Lề Lối)
        </span>
      </div>
    </div>

    <!-- 1. HERO -->
    <Hero
      actions={[
        { variant: 'primary', text: 'Thỉnh Trang & Thẩm Định', href: 'https://zalo.me', target: '_blank', class: 'bg-[#D4AF37] text-[#240303] hover:bg-[#C5A059] font-bold border-none shadow-md' },
      ]}
    >
      <Fragment slot="title">
        <span class="text-[#D4AF37] font-serif tracking-wide drop-shadow-sm">CHÂN TRUYỀN LỀ LỐI TIỀN NHÂN</span> <br />
        <span class="text-stone-100 font-serif text-3xl sm:text-4xl">Bảo Chứng Ngọc Học Thuần Khiết</span>
      </Fragment>
      <Fragment slot="subtitle">
        <span class="text-stone-200 text-base leading-relaxed">Không gian khảo cứu dành riêng cho các bậc đồng đền, đạo quan và nhà sưu tầm trân quý quy thức khăn chầu áo ngự Tứ Phủ cùng giá trị vĩnh cửu của ngọc Phỉ Thúy loại A.</span>
      </Fragment>
    </Hero>

    <!-- 2. QUY THỨC SẮC PHỤC (ÉP MÀU VÀNG KIM & TRẮNG RÕ NÉT) -->
    <div class="py-12 border-t border-[#D4AF37]/20">
      <Content
        isReversed
        tagline="SẮC PHỤC TỨ PHỦ"
        title="Quy Thức Khăn Chầu Áo Ngự"
        classes={{ 
          container: 'text-stone-100', 
          title: '!text-[#D4AF37] font-serif font-bold text-3xl',
        }}
        items={[
          { title: 'Đỏ Thiên Phủ — Uy Nghi Tối Thượng', description: 'Gấm thêu chỉ kim tuyến chuẩn mực dành cho hàng Quan Lớn, Chầu Bà Đệ Nhất. Tuyệt đối không phối tạp sắc.' },
          { title: 'Xanh Nhạc Phủ & Vàng Địa Phủ', description: 'Sắc ngọc bích của rừng ngàn và sắc hoàng kim của đất mẹ. Giữ trọn thần thái tôn nghiêm khi loan giá ngự đồng.' },
          { title: 'Trắng Thoải Phủ — Thanh Khiết Bất Nhiễm', description: 'Sắc trắng thanh tịnh Thoải Phủ đính sa hạt và thêu hoa sen giấu chỉ tinh tế bậc nhất.' },
        ]}
      >
        <Fragment slot="content">
          <p class="text-[#D4AF37] font-serif italic text-lg mb-2">"Gửi nét chỉ hoa, họa hồn phượng gấm"</p>
          <span class="text-stone-300">Mỗi tấm áo ngự là một lòng thành kính dâng lên Thánh Mẫu và chư vị Thánh triều.</span>
        </Fragment>
      </Content>
    </div>

    <!-- 3. MINH BẠCH NGỌC HỌC (THẺ NỀN ĐỎ ĐEN VIỀN HOÀNG KIM) -->
    <div class="py-12 bg-[#1C0202] border-y border-[#D4AF37]/20">
      <Features2
        title="Minh Bạch Ngọc Học — 100% Cẩm Thạch Loại A"
        subtitle="Minh bạch chứng thư quang phổ hồng ngoại FTIR, tuyệt đối không bán ngọc xử lý hóa chất."
        columns={3}
        classes={{ 
          title: '!text-[#D4AF37] font-serif font-bold text-3xl', 
          subtitle: '!text-stone-300',
          panel: '!bg-[#2D0505] !border !border-[#D4AF37]/30 !text-stone-100 shadow-md',
        }}
        items={[
          { title: 'Giám Định Viện Đá Quý', description: 'Mỗi vòng ngọc kèm mã số kiểm định độc lập từ PNJ Lab / RGG / SJC.', icon: 'tabler:certificate' },
          { title: 'Nước Ngọc & Độ Mướt', description: 'Thớ ngọc đan chặt mịn màng, lên nước sáng bóng theo năm tháng dưỡng ngọc.', icon: 'tabler:sparkles' },
          { title: 'Trường Năng Lượng Đất Mẹ', description: 'Hấp thụ linh khí tự nhiên hàng triệu năm, hỗ trợ điều hòa từ trường an định.', icon: 'tabler:shield-check' },
        ]}
      />
    </div>

    <!-- 4. LỜI MỜI HỘI NGỘ -->
    <CallToAction
      actions={[
        { variant: 'primary', text: 'Đàm Đạo Quy Thức & Xem Ngọc', href: 'https://zalo.me', target: '_blank', class: 'bg-[#D4AF37] text-[#240303] font-bold hover:bg-[#C5A059] border-none shadow-lg' },
      ]}
    >
      <Fragment slot="title"><span class="!text-[#D4AF37] font-serif text-3xl">Hội Ngộ Cùng Việt Nghi</span></Fragment>
      <Fragment slot="subtitle"><span class="text-stone-300">Kính mời quý thầy ghé đàm đạo về quy thức phục trang hoặc trực tiếp soi nước ngọc dưới ánh sáng chuyên dụng.</span></Fragment>
    </CallToAction>
  </div>
</Layout>
