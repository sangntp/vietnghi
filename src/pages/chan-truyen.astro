---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Việt Nghi — Chân Truyền Lề Lối & Giám Định Ngọc Học',
};
---

<Layout metadata={metadata}>
  <!-- NỀN ĐỎ GẤM THIÊN PHỦ XUYÊN SUỐT CẢ TRANG -->
  <div class="bg-[#2D0404] text-[#F7EFE9] min-h-screen">
    
    <!-- THANH CHUYỂN KHÔNG GIAN DẪN VỀ KHỞI DUYÊN -->
    <div class="bg-[#1A0202] border-b border-[#D4AF37]/30 text-center py-2 px-4 flex justify-center items-center gap-3">
      <span class="text-xs text-[#D4AF37] font-serif">KHÔNG GIAN CHÂN TRUYỀN (LỀ LỐI ĐẠO MẪU & NGỌC HỌC)</span>
      <a href="/" class="bg-[#FAF8F5] text-[#1B4D3E] hover:bg-white px-3 py-1 rounded-full text-xs font-semibold shadow transition">
        🌿 Về Không Gian Khởi Duyên (Người Trẻ) →
      </a>
    </div>

    <!-- 1. Hero: Đỏ Rượu & Vàng Kim -->
    <Hero
      actions={[
        { variant: 'primary', text: 'Thỉnh Trang & Thẩm Định', href: 'https://zalo.me', target: '_blank', class: 'bg-[#D4AF37] text-[#2D0404] hover:bg-[#C5A059] font-bold border-none' },
      ]}
    >
      <Fragment slot="title">
        <span class="text-[#D4AF37] font-serif tracking-wide">CHÂN TRUYỀN LỀ LỐI TIỀN NHÂN</span> <br />
        <span class="text-white font-serif text-3xl sm:text-4xl">Bảo Chứng Ngọc Học Thuần Khiết</span>
      </Fragment>
      <Fragment slot="subtitle">
        <span class="text-stone-200">Không gian khảo cứu dành riêng cho các bậc đồng đền, đạo quan và nhà sưu tầm trân quý quy thức khăn chầu áo ngự Tứ Phủ cùng giá trị vĩnh cửu của ngọc Phỉ Thúy loại A.</span>
      </Fragment>
    </Hero>

    <!-- 2. Sắc Phục Tứ Phủ (Chữ trắng sáng & vàng kim, không bao giờ bị chìm) -->
    <Content
      isReversed
      tagline="SẮC PHỤC TỨ PHỦ"
      title="Quy Thức Khăn Chầu Áo Ngự"
      classes={{ container: 'text-stone-100', title: 'text-[#D4AF37] font-serif' }}
      items={[
        { title: 'Đỏ Thiên Phủ — Uy Nghi Tối Thượng', description: 'Gấm thêu chỉ kim tuyến chuẩn mực dành cho hàng Quan Lớn, Chầu Bà Đệ Nhất. Tuyệt đối không phối tạp sắc.' },
        { title: 'Xanh Nhạc Phủ & Vàng Địa Phủ', description: 'Sắc ngọc bích của rừng ngàn và sắc hoàng kim của đất mẹ. Giữ trọn thần thái tôn nghiêm khi loan giá ngự đồng.' },
        { title: 'Trắng Thoải Phủ — Thanh Khiết Bất Nhiễm', description: 'Sắc trắng thanh tịnh Thoải Phủ đính sa hạt và thêu hoa sen giấu chỉ tinh tế bậc nhất.' },
      ]}
    >
      <Fragment slot="content">
        <p class="text-[#D4AF37] font-serif italic text-lg mb-2">"Gửi nét chỉ hoa, họa hồn phượng gấm"</p>
        <span class="text-stone-200">Mỗi tấm áo ngự là một lòng thành kính dâng lên Thánh Mẫu và chư vị Thánh triều.</span>
      </Fragment>
    </Content>

    <!-- 3. Giám Định Ngọc Học -->
    <div class="py-8 bg-[#200303]">
      <Features2
        title="Minh Bạch Ngọc Học — 100% Cẩm Thạch Loại A"
        subtitle="Minh bạch chứng thư quang phổ hồng ngoại FTIR, tuyệt đối không bán ngọc xử lý hóa chất."
        columns={3}
        classes={{ title: 'text-[#D4AF37] font-serif', subtitle: 'text-stone-300' }}
        items={[
          { title: 'Giám Định Viện Đá Quý', description: 'Kèm mã số kiểm định độc lập từ PNJ Lab / RGG / SJC.', icon: 'tabler:certificate' },
          { title: 'Nước Ngọc & Độ Mướt', description: 'Thớ ngọc mịn màng, lên nước bóng đẹp theo năm tháng dưỡng ngọc.', icon: 'tabler:sparkles' },
          { title: 'Trường Năng Lượng Tự Nhiên', description: 'Hấp thụ linh khí đất mẹ, hỗ trợ điều hòa từ trường an định.', icon: 'tabler:shield-check' },
        ]}
      />
    </div>

    <!-- 4. Lời Mời Đàm Đạo -->
    <CallToAction
      actions={[
        { variant: 'primary', text: 'Đàm Đạo Quy Thức & Xem Ngọc', href: 'https://zalo.me', target: '_blank', class: 'bg-[#D4AF37] text-[#2D0404] font-bold hover:bg-[#C5A059] border-none' },
      ]}
    >
      <Fragment slot="title"><span class="text-[#D4AF37] font-serif">Hội Ngộ Cùng Việt Nghi</span></Fragment>
      <Fragment slot="subtitle"><span class="text-stone-200">Kính mời quý thầy ghé đàm đạo về quy thức phục trang hoặc trực tiếp soi nước ngọc dưới ánh sáng chuyên dụng.</span></Fragment>
    </CallToAction>
  </div>
</Layout>
