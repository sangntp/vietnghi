---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Việt Nghi — Gìn giữ lề lối tiền nhân, nuôi dưỡng an yên nội tâm',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- 1. Màn Diện Kiến (Hero) -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Thỉnh Duyên Qua Zalo',
        href: 'https://zalo.me',
        target: '_blank',
        icon: 'tabler:message-circle',
      },
      { text: 'Chiêm Ngưỡng Tam Phẩm', href: '#tam-pham' },
    ]}
  >
    <Fragment slot="title">
      Gìn giữ lề lối tiền nhân <br />
      <span class="text-accent dark:text-emerald-400 highlight">Nuôi dưỡng an yên nội tâm</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold text-emerald-800 dark:text-emerald-300">Việt Nghi</span> — Không gian tôn vinh vẻ đẹp văn hóa bản địa qua Khăn chầu áo ngự thủ công, Pháp phục thiền tịnh và Ngọc cẩm thạch tự nhiên loại A.
    </Fragment>
  </Hero>

  <!-- 2. Giới thiệu Tam Phẩm Tinh Hoa -->
  <Features
    id="tam-pham"
    tagline="Tam Phẩm Tinh Hoa"
    title="Nét Đẹp Truyền Thừa & Tâm Thức"
    subtitle="Mỗi tác phẩm tại Việt Nghi đều được kiến tạo từ sự tôn kính lề lối cổ truyền và chắt lọc năng lượng thuần khiết."
    items={[
      {
        title: 'Khăn Chầu Áo Ngự',
        description:
          'Kế thừa mỹ học trang phục tín ngưỡng Đạo Mẫu. Thêu tay thủ công nghiêm cẩn trong từng đường kim mũi chỉ theo đúng điển tích và màu sắc bản mệnh.',
        icon: 'tabler:sparkles',
      },
      {
        title: 'Pháp Phục Thiền Tịnh',
        description:
          'Dệt từ sợi tự nhiên như đũi tơ tằm, linen mộc. Thiết kế tối giản, thanh nhã, nâng niu thân tâm trong từng thời khắc hành lễ hay tĩnh tọa.',
        icon: 'tabler:leaf',
      },
      {
        title: 'Ngọc Cẩm Thạch Loại A',
        description:
          '100% ngọc Phỉ Thúy tự nhiên chưa qua xử lý hóa chất. Minh bạch chứng thư giám định, gửi gắm triết lý ngọc dưỡng người, nuôi dưỡng an lành.',
        icon: 'tabler:diamond',
      },
    ]}
  />

  <!-- 3. Tự động kéo bài viết từ bạn Content -->
  <BlogLatestPosts
    title="Góc Kể Chuyện & Điển Tích"
    information="Những lát cắt văn hóa, câu chuyện khảo cứu tín ngưỡng và sổ tay ngọc học được chắt lọc từ tâm huyết."
  />

  <!-- 4. Lời mời kết duyên (Call To Action) -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Nhận Tư Vấn Hữu Duyên',
        href: 'https://zalo.me',
        target: '_blank',
        icon: 'tabler:message-circle',
      },
    ]}
  >
    <Fragment slot="title">
      Khởi Duyên Cùng <span class="text-emerald-800 dark:text-emerald-300">Việt Nghi</span>
    </Fragment>

    <Fragment slot="subtitle">
      Mỗi vật phẩm là một mối nhân duyên. Kính mời Thầy và quý bạn ghé thăm để lắng nghe những câu chuyện và chọn cho mình vật phẩm tương hợp.
    </Fragment>
  </CallToAction>
</Layout>
