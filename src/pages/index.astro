---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Việt Nghi — Chạm nét cổ truyền, tìm an yên giữa phố thị',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- 1. Hero: Năng lượng tươi trẻ & Lời mời chuyển không gian -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Nhận Tư Vấn Chọn Ni Tay',
        href: 'https://zalo.me',
        target: '_blank',
        icon: 'tabler:message-circle',
      },
      {
        text: '☯ Chuyển Sang Không Gian Chân Truyền',
        href: '/chan-truyen',
        icon: 'tabler:arrow-narrow-right',
      },
    ]}
  >
    <Fragment slot="title">
      Chạm nét cổ truyền <br />
      <span class="text-emerald-700 dark:text-emerald-400 highlight">Tìm an yên giữa phố thị</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="font-semibold text-emerald-800 dark:text-emerald-300">Việt Nghi · Khởi Duyên</span> — Không gian dành cho người trẻ yêu cái đẹp truyền thống. Nơi mỗi chiếc vòng ngọc tự nhiên và nếp áo đũi mộc mang lại sự thư thái, cân bằng năng lượng nội tâm.
    </Fragment>
  </Hero>

  <!-- 2. Tam Phẩm theo góc nhìn Hiện đại & Chữa lành -->
  <Features
    id="kham-pha"
    tagline="Nếp Sống Tỉnh Thức"
    title="Năng Lượng Thuần Khiết Từ Thiên Nhiên & Bàn Tay Nghệ Nhân"
    subtitle="Không nặng nề lễ nghi phức tạp, Việt Nghi mang vẻ đẹp cội nguồn hòa nhịp cùng phong cách sống tối giản của người trẻ."
    items={[
      {
        title: 'Vòng Ngọc Cẩm Thạch A',
        description:
          '100% ngọc tự nhiên không qua xử lý hay nhuộm màu. Điểm tựa năng lượng an lành, mát lạnh nơi cổ tay, đồng hành cùng bạn qua từng nhịp sống hối hả.',
        icon: 'tabler:sparkles',
      },
      {
        title: 'Pháp Phục Ứng Dụng',
        description:
          'Chất liệu đũi tơ tằm, linen mộc mạc thoáng khí. Phom dáng hiện đại, thanh thoát, phù hợp cả khi tĩnh tọa thưởng trà lẫn dạo phố thường nhật.',
        icon: 'tabler:leaf',
      },
      {
        title: 'Mỹ Học Di Sản Bản Địa',
        description:
          'Chiêm ngưỡng nghệ thuật thêu tay khăn chầu áo ngự dưới góc nhìn văn hóa và thủ công mỹ nghệ tinh hoa, rũ bỏ mọi định kiến mê tín dị đoan.',
        icon: 'tabler:palette',
      },
    ]}
  />

  <!-- 3. Hướng dẫn 3 bước đo ni tay trong 30 giây (Giải quyết rào cản người mới) -->
  <Steps
    title="Chỉ 30 giây để tìm chiếc vòng ngọc tương hợp"
    items={[
      {
        title: 'Bước 1: Chuẩn bị sợi dây nhỏ',
        description: 'Dùng một sợi chỉ hoặc mảnh giấy quấn quanh phần rộng nhất của bàn tay khi chụm các ngón lại.',
        icon: 'tabler:ruler',
      },
      {
        title: 'Bước 2: Đo chiều dài',
        description: 'Đo chiều dài đoạn dây bằng thước kẻ thông thường để tính ra đường kính (ni tay) chính xác của bạn.',
        icon: 'tabler:check',
      },
      {
        title: 'Bước 3: Nhắn tin cho Việt Nghi',
        description: 'Gửi số đo cho chúng tôi để được tư vấn phiến ngọc cẩm thạch có năng lượng và màu sắc tương sinh.',
        icon: 'tabler:message',
      },
    ]}
  />

  <!-- 4. Góc Kể Chuyện: Bài viết phong cách chữa lành từ bạn Content -->
  <BlogLatestPosts
    title="Góc Tĩnh Lặng & Kể Chuyện"
    information="Những câu chuyện nhỏ về triết lý ngọc dưỡng người, nếp sống an tịnh và nét đẹp di sản tiền nhân."
  />

  <!-- 5. Lời gọi kết nối gần gũi -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Trò Chuyện Hữu Duyên',
        href: 'https://zalo.me',
        target: '_blank',
        icon: 'tabler:brand-hipchat',
      },
    ]}
  >
    <Fragment slot="title">
      Mỗi cơ duyên tao ngộ đều là một điều lành
    </Fragment>

    <Fragment slot="subtitle">
      Đừng ngần ngại nhắn tin cho Việt Nghi nếu bạn cần một người bạn đồng hành chia sẻ về ngọc, về trang phục mộc và lối sống an yên.
    </Fragment>
  </CallToAction>
</Layout>
